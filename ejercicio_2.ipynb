    "mediciones = []\n",
    "\n",
    "for direccion, s in zip(direcciones, desplazamientos):\n",
    "    \n",
    "    M = mascara_rayo(8, direccion, s)\n",
    "    \n",
    "    b_r = np.sum(M * X_fantoma)\n",
    "    \n",
    "    mediciones.append(b_r)\n",
    "    \n",
    "    print(f\"Dirección {direccion}, s={s}: b_r = {b_r}\")"
   ]
